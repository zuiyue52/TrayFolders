root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows profile APIs require a UTF-16 BOM for Unicode INI files.
[config/defaults/*.ini]
charset = utf-16le
